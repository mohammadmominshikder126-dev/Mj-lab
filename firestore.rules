rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'nexasworld5@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'description', 'category', 'imageUrl', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'category', 'imageUrl', 'demoUrl', 'whatsappUrl', 'status', 'price', 'featured', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.description is string && data.description.size() >= 4 && data.description.size() <= 1000
        && data.category is string && data.category in ['New Design', 'E-Commerce', 'Business', 'Portfolio']
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000
        && (!('demoUrl' in data) || (data.demoUrl is string && data.demoUrl.size() <= 500))
        && (!('whatsappUrl' in data) || (data.whatsappUrl is string && data.whatsappUrl.size() <= 500))
        && data.status is string && data.status in ['Active', 'Inactive']
        && (!('price' in data) || (data.price is string && data.price.size() <= 40))
        && (!('featured' in data) || data.featured is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['badgeText', 'title', 'highlightWord', 'description', 'buttonText', 'buttonLink', 'imageUrl', 'order', 'active', 'createdAt', 'updatedAt'])
        && (!('badgeText' in data) || (data.badgeText is string && data.badgeText.size() <= 80))
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && (!('highlightWord' in data) || (data.highlightWord is string && data.highlightWord.size() <= 60))
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && (!('buttonText' in data) || (data.buttonText is string && data.buttonText.size() <= 50))
        && (!('buttonLink' in data) || (data.buttonLink is string && data.buttonLink.size() <= 500))
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 350000
        && (!('order' in data) || data.order is number)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSocialLinks(links) {
      return links is map
        && links.keys().hasOnly(['facebook', 'github', 'linkedin', 'youtube', 'instagram', 'twitter'])
        && (!('facebook' in links) || (links.facebook is string && links.facebook.size() <= 300))
        && (!('github' in links) || (links.github is string && links.github.size() <= 300))
        && (!('linkedin' in links) || (links.linkedin is string && links.linkedin.size() <= 300))
        && (!('youtube' in links) || (links.youtube is string && links.youtube.size() <= 300))
        && (!('instagram' in links) || (links.instagram is string && links.instagram.size() <= 300))
        && (!('twitter' in links) || (links.twitter is string && links.twitter.size() <= 300));
    }

    function isValidWebsiteSettings(data) {
      return data.keys().hasAll(['siteName', 'whatsappNumber', 'theme', 'updatedAt'])
        && data.keys().hasOnly(['siteName', 'tagline', 'description', 'theme', 'logoUrl', 'faviconUrl', 'whatsappNumber', 'aboutTitle', 'aboutDescription', 'footerText', 'socialLinks', 'updatedAt'])
        && data.siteName is string && data.siteName.size() >= 1 && data.siteName.size() <= 80
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 120))
        && (!('description' in data) || (data.description is string && data.description.size() <= 600))
        && data.theme is string && data.theme in ['Dark', 'Midnight', 'Ocean']
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000))
        && (!('faviconUrl' in data) || (data.faviconUrl is string && data.faviconUrl.size() <= 350000))
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 6 && data.whatsappNumber.size() <= 24 && data.whatsappNumber.matches('^[+0-9\\s\\-]+$')
        && (!('aboutTitle' in data) || (data.aboutTitle is string && data.aboutTitle.size() <= 140))
        && (!('aboutDescription' in data) || (data.aboutDescription is string && data.aboutDescription.size() <= 2000))
        && (!('footerText' in data) || (data.footerText is string && data.footerText.size() <= 240))
        && (!('socialLinks' in data) || isValidSocialLinks(data.socialLinks))
        && data.updatedAt is timestamp;
    }

    function isValidTeamMember(data) {
      return data.keys().hasAll(['name', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'role', 'bio', 'avatarUrl', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.role is string && data.role.size() >= 2 && data.role.size() <= 80
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 400))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 350000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['name', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 120))
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 2000
        && data.status is string && data.status in ['Unread', 'Read']
        && data.createdAt is timestamp;
    }

    function isValidVisitorEvent(data) {
      return data.keys().hasAll(['visitorHash', 'dateKey', 'isUnique', 'device', 'createdAt'])
        && data.keys().hasOnly(['visitorHash', 'dateKey', 'isUnique', 'page', 'device', 'createdAt'])
        && data.visitorHash is string && data.visitorHash.size() >= 4 && data.visitorHash.size() <= 80 && data.visitorHash.matches('^[a-zA-Z0-9_\\-]+$')
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.isUnique is bool
        && (!('page' in data) || (data.page is string && data.page.size() <= 120))
        && data.device is string && data.device in ['Mobile', 'Tablet', 'Desktop']
        && data.createdAt is timestamp;
    }

    function isValidContactClick(data) {
      return data.keys().hasAll(['source', 'dateKey', 'createdAt'])
        && data.keys().hasOnly(['source', 'projectId', 'projectName', 'dateKey', 'createdAt'])
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 80
        && (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128))
        && (!('projectName' in data) || (data.projectName is string && data.projectName.size() <= 120))
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    function isValidOrderRequest(data) {
      return data.keys().hasAll(['clientName', 'clientContact', 'projectName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['clientName', 'clientContact', 'projectId', 'projectName', 'category', 'notes', 'status', 'createdAt', 'updatedAt'])
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 80
        && data.clientContact is string && data.clientContact.size() >= 3 && data.clientContact.size() <= 120
        && (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128))
        && data.projectName is string && data.projectName.size() >= 2 && data.projectName.size() <= 120
        && (!('category' in data) || (data.category is string && data.category.size() <= 60))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && data.status is string && data.status in ['Pending', 'In Progress', 'Completed', 'Cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80))
        && data.role == 'admin'
        && data.updatedAt is timestamp;
    }

    match /test/connection {
      allow get: if true;
    }

    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (existing().status == 'Active' || isAdmin());
      allow list: if resource.data.status == 'Active' || isAdmin();
      allow create: if isValidId(projectId) && isAdmin() && isValidProject(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) && isAdmin() && isValidProject(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'category', 'imageUrl', 'demoUrl', 'whatsappUrl', 'status', 'price', 'featured', 'updatedAt']);
      allow delete: if isValidId(projectId) && isAdmin();
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create: if isValidId(bannerId) && isAdmin() && isValidBanner(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(bannerId) && isAdmin() && isValidBanner(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['badgeText', 'title', 'highlightWord', 'description', 'buttonText', 'buttonLink', 'imageUrl', 'order', 'active', 'updatedAt']);
      allow delete: if isValidId(bannerId) && isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isValidId(settingId) && isAdmin() && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidWebsiteSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['siteName', 'tagline', 'description', 'theme', 'logoUrl', 'faviconUrl', 'whatsappNumber', 'aboutTitle', 'aboutDescription', 'footerText', 'socialLinks', 'updatedAt']);
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /team/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) && isAdmin() && isValidTeamMember(incoming())
        && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(memberId) && isAdmin() && isValidTeamMember(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'bio', 'avatarUrl', 'updatedAt']);
      allow delete: if isValidId(memberId) && isAdmin();
    }

    match /contacts/{contactId} {
      allow get: if isValidId(contactId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(contactId) && isValidContactMessage(incoming())
        && incoming().status == 'Unread'
        && incoming().createdAt == request.time;
      allow update: if isValidId(contactId) && isAdmin() && isValidContactMessage(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(contactId) && isAdmin();
    }

    match /visitors/{visitorId} {
      allow get: if isValidId(visitorId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(visitorId) && isValidVisitorEvent(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(visitorId) && isAdmin();
    }

    match /contact_clicks/{clickId} {
      allow get: if isValidId(clickId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(clickId) && isValidContactClick(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(clickId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrderRequest(incoming())
        && incoming().status == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isAdmin() && isValidOrderRequest(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerified() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming()) && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }
  }
}
