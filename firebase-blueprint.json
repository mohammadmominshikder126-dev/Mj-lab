{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A website portfolio project created by MJ LAB.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "description": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "category": { "type": "string", "enum": ["New Design", "E-Commerce", "Business", "Portfolio"] },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 350000 },
        "demoUrl": { "type": "string", "maxLength": 500 },
        "whatsappUrl": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "price": { "type": "string", "maxLength": 40 },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "category", "imageUrl", "status", "createdAt", "updatedAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Hero slider banner displayed on the MJ LAB website.",
      "type": "object",
      "properties": {
        "badgeText": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "highlightWord": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "buttonText": { "type": "string", "maxLength": 50 },
        "buttonLink": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "order": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "active", "createdAt", "updatedAt"]
    },
    "WebsiteSettings": {
      "title": "WebsiteSettings",
      "description": "Global MJ LAB website configuration, branding, WhatsApp number, About section, and social links.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 600 },
        "theme": { "type": "string", "enum": ["Dark", "Midnight", "Ocean"] },
        "logoUrl": { "type": "string", "maxLength": 350000 },
        "faviconUrl": { "type": "string", "maxLength": 350000 },
        "whatsappNumber": { "type": "string", "minLength": 6, "maxLength": 24, "pattern": "^[+0-9\\s\\-]+$" },
        "aboutTitle": { "type": "string", "maxLength": 140 },
        "aboutDescription": { "type": "string", "maxLength": 2000 },
        "footerText": { "type": "string", "maxLength": 240 },
        "socialLinks": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName", "whatsappNumber", "theme", "updatedAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "MJ LAB developer or designer team profile.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "role": { "type": "string", "minLength": 2, "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 400 },
        "avatarUrl": { "type": "string", "maxLength": 350000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "createdAt", "updatedAt"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Private client contact message submitted from the public website.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "subject": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "status": { "type": "string", "enum": ["Unread", "Read"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "message", "status", "createdAt"]
    },
    "VisitorEvent": {
      "title": "VisitorEvent",
      "description": "Visitor session log for daily, weekly, monthly, and unique visitor analytics.",
      "type": "object",
      "properties": {
        "visitorHash": { "type": "string", "minLength": 4, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "isUnique": { "type": "boolean" },
        "page": { "type": "string", "maxLength": 120 },
        "device": { "type": "string", "enum": ["Mobile", "Tablet", "Desktop"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["visitorHash", "dateKey", "isUnique", "device", "createdAt"]
    },
    "ContactClick": {
      "title": "ContactClick",
      "description": "WhatsApp contact button click event for conversion tracking.",
      "type": "object",
      "properties": {
        "source": { "type": "string", "maxLength": 80 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectName": { "type": "string", "maxLength": 120 },
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["source", "dateKey", "createdAt"]
    },
    "OrderRequest": {
      "title": "OrderRequest",
      "description": "Website order or service quote request submitted by a client.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "clientContact": { "type": "string", "minLength": 3, "maxLength": 120 },
        "projectId": { "type": "string", "maxLength": 128 },
        "projectName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "category": { "type": "string", "maxLength": 60 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Completed", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "clientContact", "projectName", "status", "createdAt", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin user record.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 80 },
        "role": { "type": "string", "enum": ["admin"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "updatedAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Portfolio projects showcased on the main website and managed in Admin Panel."
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Hero slider banners displayed on the main website."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/WebsiteSettings" },
      "description": "Site configuration document (primary doc: site)."
    },
    "/team/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Team members displayed in About section and managed in Admin Panel."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Private client contact messages; writeable by visitors, readable/manageable only by admins."
    },
    "/visitors/{visitorId}": {
      "schema": { "$ref": "#/entities/VisitorEvent" },
      "description": "Visitor analytics log; append-only for visitors, readable/deletable only by admins."
    },
    "/contact_clicks/{clickId}": {
      "schema": { "$ref": "#/entities/ContactClick" },
      "description": "WhatsApp click tracking events; append-only for visitors, readable/deletable only by admins."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRequest" },
      "description": "Client website purchase/order requests; createable by visitors, managed by admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized admin accounts."
    }
  }
}
